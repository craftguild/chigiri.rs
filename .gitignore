!/fuzz/corpus/parser/nesting-limit
!/fuzz/corpus/parser/query
!/fuzz/corpus/persisted_id/invalid
!/fuzz/corpus/persisted_id/valid
!/fuzz/corpus/sdl_composition/cycle
!/fuzz/corpus/sdl_composition/schema

# Generator-owned Cargo cache outside the generated ownership tree.
/generated/.chigiri-cache/target/
