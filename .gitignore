# Keep the fixed regression corpus; ignore local fuzz discoveries.
/fuzz/artifacts/
/fuzz/corpus/*/*
!/fuzz/corpus/config_parser/closed-shape
!/fuzz/corpus/config_parser/valid
!/fuzz/corpus/http_decode/document
!/fuzz/corpus/http_decode/malformed
!/fuzz/corpus/json_conversion/nested
