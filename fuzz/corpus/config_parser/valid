# Configure the SDL input and runtime source.
schema_version = "chigiri/config-v2"

[schema]
directory = "graphql"

[package]
name = "graphql-contract"
version = "0.1.0"
edition = "2024"

[generation]
output = "generated/graphql-contract"

[bindings]
domain_enums = []

